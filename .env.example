# --- Base de données PostGIS ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aerotwin_db

# Chaîne de connexion utilisée par le code Python (SQLAlchemy / GeoAlchemy2)
# Format : postgresql://<user>:<password>@<host>:<port>/<db>
DB_URL=postgresql://admin:change_me@localhost:5432/aerotwin_db

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# --- API Météo (Aviation Weather Center) ---
# L'API METAR de l'AWC est publique et ne nécessite pas de clé.
# Variable conservée pour une éventuelle source météo authentifiée.
METAR_STATION=LFBO
